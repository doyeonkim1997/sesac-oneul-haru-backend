generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  userId       Int       @id @default(autoincrement())
  nickName     String    
  email        String    @unique
  password     String
  authType     String @map("authType")
  tier         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime?

  // Relations
  friendRequestsSent     FriendRequest[] @relation("Requester")
  friendRequestsReceived FriendRequest[] @relation("Receiver")
  image                 Image?          @relation(fields: [imageId], references: [imageId])
  imageId               Int?            @unique
  // auths                  Auth[]
  bookmarks              Bookmark[]
  goals                  Goal[]
}

model EmailVerification {
  emailId             Int      @id @default(autoincrement())
  email          String   
  validCode      String
  expirationTime DateTime?
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model FriendRequest {
  requestId    Int      @id @default(autoincrement())
  userId  Int @map("requesterId")
  receiverId   Int
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  // Relations
  user User @relation("Requester",fields: [userId], references: [userId], onDelete: Cascade)
  receiver  User @relation("Receiver", fields: [receiverId], references: [userId], onDelete: Cascade)
}

model Image {
  imageId   Int    @id @default(autoincrement())
  imageUrl  String

  // Relations
  user User?
}

