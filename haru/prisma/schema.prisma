model Bookmark {
  bookmarkId   Int     @id @default(autoincrement())  @map("bookmark_id")
  userId       Int     @map("user_id")
  goalId       Int     @map("goal_id")
  isBookmarked Boolean @default(false)  @map("is_bookmarked")

  // Relations
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [goalId], onDelete: Cascade)

  @@unique([userId, goalId])
}

model Goal {
  goalId      Int       @id @default(autoincrement()) @map("goal_id")
  userId      Int       @map("user_id")
  title       String    @map("title")
  content     String    @map("content")
  category    String    @default("ETC") @map("category")
  isCompleted Boolean   @default(false) @map("is_completed")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  cheerCount  Int       @default(0)     @map("cheer_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  // Relations
  bookmarks Bookmark[]
  user      User?      @relation(fields: [userId], references: [userId], onDelete: Cascade)
}
